# FoundersSuite Interview Intelligence API — environment variables
# Copy to .env and fill in your real keys before running.

# ── OpenAI (required for AI summary and intelligence analysis) ────────────────
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── LiveKit (required for real-time video room tokens) ───────────────────────
# Sign up at https://livekit.io — free tier available
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ── Supabase (optional — for persistent meeting storage) ─────────────────────
# Leave blank to use local in-memory storage instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
