# FoundersSuite Frontend — environment variables
# Copy to .env.local before running next dev / next start.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_ML_API_URL=http://localhost:8001
NEXT_PUBLIC_INTERVIEW_API_URL=http://localhost:8000

# Set to false to use real backends; true to stub all API calls with mock data
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_USE_MOCK_FORMS=false
NEXT_PUBLIC_USE_MOCK_AGENTS=false
NEXT_PUBLIC_USE_MOCK_USERS=false
NEXT_PUBLIC_USE_MOCK_ML=false
NEXT_PUBLIC_USE_MOCK_INTERVIEW=false
